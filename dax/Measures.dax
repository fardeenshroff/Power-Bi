-- Create these as separate measures in the SalesOrders table.
Total Revenue = SUMX(SalesOrders, SalesOrders[quantity] * SalesOrders[unit_price])
Order Count = DISTINCTCOUNT(SalesOrders[order_id])
Total Units = SUM(SalesOrders[quantity])
Average Order Value = DIVIDE([Total Revenue], [Order Count])
Revenue per Unit = DIVIDE([Total Revenue], [Total Units])
